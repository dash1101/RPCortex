+    #endif
     if (ret != 0) {
         return ret;
     }
 
     // Download the main WiFi firmware blob to the 43xx device.
+    #if CYW43_FW_STREAM
+    ret = cyw43_download_stream(self, 0x00000000, CYW43_WRITE_BYTES_PAD(CYW43_WIFI_FW_LEN), CYW43_FW_WIFI);
+    #else
