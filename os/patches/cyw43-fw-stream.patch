 static void cyw43_write_iovar_u32(cyw43_int_t *self, const char *var, uint32_t val, uint32_t iface) {
     uint8_t *buf = &self->spid_buf[SDPCM_HEADER_LEN + 16];
     size_t len = strlen(var) + 1;
@@ -1634,13 +1707,27 @@
     cyw43_write_backplane(self, SOCSRAM_BANKX_PDA, 4, 0);
 
     // Check that valid chipset firmware exists at the given source address.
+    #if CYW43_FW_STREAM
+    // That check reads only the end of the firmware, which is kept uncompressed.
+    // The CLM is checked here as well, while the WLAN core is still in reset,
+    // because it is not sent until after the core has started.
+    int ret = cyw43_check_valid_chipset_firmware(self, CYW43_FW_TAIL_LEN, (uintptr_t)cyw43_fw_tail);
+    if (ret == 0) {
+        ret = cyw43_clm_stream(self, false);
